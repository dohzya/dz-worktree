function __git_wt_repo_root
    set -l common_dir (git rev-parse --git-common-dir 2>/dev/null)
    or begin
        echo "Not in a git repository" >&2
        return 1
    end
    realpath "$common_dir/.."
end

# dz-worktree-init:start
function git-worktree-init --description "Install dz-worktree hooks into the current or specified repo"
    echo "git-worktree-init is generated by scripts/install." >&2
    echo "Run scripts/install, then restart or source your shell config." >&2
    return 1
end
# dz-worktree-init:end

function __git_wt_resolve --description "Resolve a ref or path to a worktree path"
    set -l input $argv[1]
    set -l path_match ""
    set -l ref_match ""

    for line in (git worktree list | grep -v '(bare)')
        set -l wt_path (echo "$line" | awk '{print $1}')
        set -l wt_branch (echo "$line" | string match -rg '\[([^\]]+)\]$')

        if test (basename "$wt_path") = "$input" -o "$wt_path" = "$input"
            set path_match "$wt_path"
        end
        if test -n "$wt_branch" -a "$wt_branch" = "$input"
            set ref_match "$wt_path"
        end
    end

    if test -n "$path_match" -a -n "$ref_match"
        if test (realpath "$path_match") = (realpath "$ref_match")
            echo "$path_match"
        else
            echo "Ambiguous: '$input' matches:" >&2
            echo "  1) path $path_match" >&2
            echo "  2) branch $input → $ref_match" >&2
            read -P "Which one? [1/2] " choice
            switch $choice
                case 1
                    echo "$path_match"
                case 2
                    echo "$ref_match"
                case '*'
                    echo "Cancelled." >&2
                    return 1
            end
        end
    else if test -n "$path_match"
        echo "$path_match"
    else if test -n "$ref_match"
        echo "$ref_match"
    else
        echo "No worktree found for '$input'" >&2
        return 1
    end
end

function __git_wt_primary --description "Path to the primary worktree (works for bare and non-bare repos)"
    if test (git rev-parse --is-bare-repository 2>/dev/null) = false
        git rev-parse --show-toplevel
        return
    end
    # Bare repo: find the worktree on the default branch
    set -l default_branch (git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | string replace 'origin/' '')
    test -z "$default_branch"; and set default_branch (git config init.defaultBranch 2>/dev/null)
    test -z "$default_branch"; and set default_branch main
    git worktree list | string match -rg '^(\S+)\s+\S+\s+\['"$default_branch"'\]$' | head -1
end

function git-worktree-switch --description "Switch to a git worktree (by ref, path, or fzf)"
    if test -n "$argv[1]"
        set -l wt_path (__git_wt_resolve "$argv[1]")
        or return 1
        cd "$wt_path"
        return
    end

    set -l selection (
        git worktree list |
        grep -v '(bare)' |
        fzf --prompt="worktree> " --height=40% \
            --preview="git -C {1} log --oneline -5 2>/dev/null"
    )
    or return 0

    set -l wt_path (echo "$selection" | awk '{print $1}')
    cd "$wt_path"
end

function __git_wt_create_usage --description "Show git-worktree-create help"
    printf '%s\n' \
        "Usage:" \
        "  git-worktree-create <branch> [path]" \
        "  git-worktree-create -b <branch> <path> [start-point]" \
        "" \
        "Options:" \
        "  -b, --branch <branch>  Branch to create or check out" \
        "  -h, --help             Show this help" \
        "" \
        "If path is omitted, the worktree directory is derived from the branch name." \
        "If the branch exists on exactly one remote, a tracking branch is created."
end

function git-worktree-create --description "Create a git worktree (tracks remote if available)"
    argparse h/help b/branch= -- $argv
    or return 1

    if set -q _flag_help
        __git_wt_create_usage
        return 0
    end

    set -l branch
    if set -q _flag_branch
        set branch $_flag_branch
    else if test (count $argv) -gt 0
        set branch $argv[1]
        set -e argv[1]
    end

    set -l wt_path
    set -l start_point
    if test (count $argv) -gt 0
        set wt_path $argv[1]
        set -e argv[1]
    end
    if test (count $argv) -gt 0
        set start_point $argv[1]
        set -e argv[1]
    end
    if test (count $argv) -gt 0
        echo "git-worktree-create: too many arguments" >&2
        return 1
    end

    if test -z "$branch"
        __git_wt_create_usage >&2
        return 1
    end

    if test -z "$wt_path"
        set -l repo_root (__git_wt_repo_root)
        or return 1

        set -l wt_dir (string replace -a '/' '-' "$branch")
        set wt_path "$repo_root/$wt_dir"
    end

    if test -d "$wt_path"
        echo "Worktree already exists at $wt_path — switching there." >&2
        cd "$wt_path"
        return 0
    end

    if test -n "$start_point"
        echo "Creating new branch '$branch' from '$start_point'..."
        git worktree add -b "$branch" "$wt_path" "$start_point"
    else if git show-ref --verify --quiet "refs/heads/$branch"
        git worktree add "$wt_path" "$branch"
    else
        set -l remote_refs (git for-each-ref --format='%(refname:short)' "refs/remotes/*/$branch")

        if test (count $remote_refs) -eq 1
            set -l remote_name (string split '/' "$remote_refs[1]")[1]
            echo "Branch '$branch' found on remote '$remote_name', creating tracking branch..."
            git worktree add -b "$branch" "$wt_path" "$remote_refs[1]"
        else if test (count $remote_refs) -gt 1
            echo "Branch '$branch' exists on multiple remotes:" >&2
            for ref in $remote_refs
                echo "  $ref" >&2
            end
            echo "Specify with: git-worktree-create <branch> and set checkout.defaultRemote" >&2
            return 1
        else
            echo "Creating new branch '$branch'..."
            git worktree add -b "$branch" "$wt_path"
        end
    end

    and cd "$wt_path"
end

function git-worktree-remove --description "Remove a git worktree (by ref, path, or fzf)"
    argparse f/force -- $argv
    or return 1

    set -l wt_path
    if test -n "$argv[1]"
        set wt_path (__git_wt_resolve "$argv[1]")
        or return 1
    else
        set -l selection (
            git worktree list |
            grep -v '(bare)' |
            fzf --prompt="remove worktree> " --height=40%
        )
        or return 0
        set wt_path (echo "$selection" | awk '{print $1}')
    end

    if not test -d "$wt_path"
        echo "Worktree not found at $wt_path" >&2
        return 1
    end

    set -l wt_name (basename "$wt_path")

    git hook run --allow-unknown-hook-name pre-remove-worktree -- "$wt_name" 2>/dev/null

    # cd out if we're inside the worktree being removed
    if test (realpath .) = (realpath "$wt_path")
        set -l primary (__git_wt_primary)
        if test -z "$primary" -o (realpath "$primary") = (realpath "$wt_path")
            set -l repo_root (__git_wt_repo_root)
            or return 1
            cd "$repo_root"
        else
            cd "$primary"
        end
        echo "Moved to $PWD"
    end

    if set -q _flag_force
        git worktree remove --force "$wt_path"
    else
        git worktree remove "$wt_path"
    end
end
