__git_wt_repo_root() {
    local common_dir
    common_dir=$(git rev-parse --git-common-dir 2>/dev/null) || {
        echo "Not in a git repository" >&2
        return 1
    }
    realpath "$common_dir/.."
}

# dz-worktree-init:start
git-worktree-init() {
    printf '%s\n' "git-worktree-init is generated by scripts/install." >&2
    printf '%s\n' "Run scripts/install, then restart or source your shell config." >&2
    return 1
}
# dz-worktree-init:end

__git_wt_resolve() {
    local input="$1"
    local path_match="" ref_match=""

    while IFS= read -r line; do
        [[ "$line" == *'(bare)'* ]] && continue
        local wt_path wt_branch
        wt_path=$(echo "$line" | awk '{print $1}')
        wt_branch=$(echo "$line" | grep -oE '\[[^]]+\]$' | tr -d '[]')

        if [[ "$(basename "$wt_path")" == "$input" || "$wt_path" == "$input" ]]; then
            path_match="$wt_path"
        fi
        if [[ -n "$wt_branch" && "$wt_branch" == "$input" ]]; then
            ref_match="$wt_path"
        fi
    done < <(git worktree list)

    if [[ -n "$path_match" && -n "$ref_match" ]]; then
        if [[ "$(realpath "$path_match")" == "$(realpath "$ref_match")" ]]; then
            echo "$path_match"
        else
            echo "Ambiguous: '$input' matches:" >&2
            echo "  1) path $path_match" >&2
            echo "  2) branch $input → $ref_match" >&2
            printf "Which one? [1/2] " >&2
            read -r choice
            case "$choice" in
                1) echo "$path_match" ;;
                2) echo "$ref_match" ;;
                *) echo "Cancelled." >&2; return 1 ;;
            esac
        fi
    elif [[ -n "$path_match" ]]; then
        echo "$path_match"
    elif [[ -n "$ref_match" ]]; then
        echo "$ref_match"
    else
        echo "No worktree found for '$input'" >&2
        return 1
    fi
}

__git_wt_primary() {
    if [[ $(git rev-parse --is-bare-repository 2>/dev/null) == false ]]; then
        git rev-parse --show-toplevel
        return
    fi
    local default_branch
    default_branch=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)
    default_branch=${default_branch#origin/}
    [[ -z "$default_branch" ]] && default_branch=$(git config init.defaultBranch 2>/dev/null)
    [[ -z "$default_branch" ]] && default_branch=main
    git worktree list | awk -v b="[$default_branch]" '$NF == b {print $1; exit}'
}

git-worktree-switch() {
    if [[ -n "$1" ]]; then
        local wt_path
        wt_path=$(__git_wt_resolve "$1") || return 1
        cd "$wt_path" || return 1
        return
    fi

    local selection
    selection=$(
        git worktree list |
        grep -v '(bare)' |
        fzf --prompt="worktree> " --height=40% \
            --preview="git -C {1} log --oneline -5 2>/dev/null"
    ) || return 0

    cd "$(echo "$selection" | awk '{print $1}')" || return 1
}

__git_wt_create_usage() {
    cat <<'EOF'
Usage:
  git-worktree-create <branch> [path]
  git-worktree-create -b <branch> <path> [start-point]

Options:
  -b, --branch <branch>  Branch to create or check out
  -h, --help             Show this help

If path is omitted, the worktree directory is derived from the branch name.
If the branch exists on exactly one remote, a tracking branch is created.
EOF
}

git-worktree-create() {
    local branch="" wt_path="" start_point=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                __git_wt_create_usage
                return 0
                ;;
            -b|--branch)
                if [[ -z "$2" ]]; then
                    echo "git-worktree-create: option requires an argument: $1" >&2
                    return 1
                fi
                branch="$2"
                shift 2
                ;;
            --)
                shift
                break
                ;;
            -*)
                echo "git-worktree-create: unknown option: $1" >&2
                return 1
                ;;
            *)
                if [[ -z "$branch" ]]; then
                    branch="$1"
                elif [[ -z "$wt_path" ]]; then
                    wt_path="$1"
                elif [[ -z "$start_point" ]]; then
                    start_point="$1"
                else
                    echo "git-worktree-create: too many arguments" >&2
                    return 1
                fi
                shift
                ;;
        esac
    done

    while [[ $# -gt 0 ]]; do
        if [[ -z "$wt_path" ]]; then
            wt_path="$1"
        elif [[ -z "$start_point" ]]; then
            start_point="$1"
        else
            echo "git-worktree-create: too many arguments" >&2
            return 1
        fi
        shift
    done

    if [[ -z "$branch" ]]; then
        __git_wt_create_usage >&2
        return 1
    fi

    if [[ -z "$wt_path" ]]; then
        local repo_root
        repo_root=$(__git_wt_repo_root) || return 1

        local wt_dir="${branch//\//-}"
        wt_path="$repo_root/$wt_dir"
    fi

    if [[ -d "$wt_path" ]]; then
        echo "Worktree already exists at $wt_path — switching there." >&2
        cd "$wt_path" || return 1
        return 0
    fi

    if [[ -n "$start_point" ]]; then
        echo "Creating new branch '$branch' from '$start_point'..."
        git worktree add -b "$branch" "$wt_path" "$start_point"
    elif git show-ref --verify --quiet "refs/heads/$branch"; then
        git worktree add "$wt_path" "$branch"
    else
        local remote_refs ref_count=0
        remote_refs=$(git for-each-ref --format='%(refname:short)' "refs/remotes/*/$branch")
        [[ -n "$remote_refs" ]] && ref_count=$(echo "$remote_refs" | wc -l | tr -d ' ')

        if [[ $ref_count -eq 1 ]]; then
            local remote_name="${remote_refs%%/*}"
            echo "Branch '$branch' found on remote '$remote_name', creating tracking branch..."
            git worktree add -b "$branch" "$wt_path" "$remote_refs"
        elif [[ $ref_count -gt 1 ]]; then
            echo "Branch '$branch' exists on multiple remotes:" >&2
            while IFS= read -r ref; do
                echo "  $ref" >&2
            done <<< "$remote_refs"
            echo "Specify with: git-worktree-create <branch> and set checkout.defaultRemote" >&2
            return 1
        else
            echo "Creating new branch '$branch'..."
            git worktree add -b "$branch" "$wt_path"
        fi
    fi

    local result=$?
    if [[ $result -eq 0 ]]; then
        cd "$wt_path" || return 1
    fi
    return "$result"
}

git-worktree-remove() {
    local force=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--force) force=true; shift ;;
            *) break ;;
        esac
    done

    local wt_path
    if [[ -n "$1" ]]; then
        wt_path=$(__git_wt_resolve "$1") || return 1
    else
        local selection
        selection=$(
            git worktree list |
            grep -v '(bare)' |
            fzf --prompt="remove worktree> " --height=40%
        ) || return 0
        wt_path=$(echo "$selection" | awk '{print $1}')
    fi

    if [[ ! -d "$wt_path" ]]; then
        echo "Worktree not found at $wt_path" >&2
        return 1
    fi

    local wt_name
    wt_name=$(basename "$wt_path")

    git hook run --allow-unknown-hook-name pre-remove-worktree -- "$wt_name" 2>/dev/null

    if [[ "$(realpath .)" == "$(realpath "$wt_path")" ]]; then
        local primary
        primary=$(__git_wt_primary)
        if [[ -z "$primary" || "$(realpath "$primary")" == "$(realpath "$wt_path")" ]]; then
            local repo_root
            repo_root=$(__git_wt_repo_root) || return 1
            cd "$repo_root" || return 1
        else
            cd "$primary" || return 1
        fi
        echo "Moved to $PWD"
    fi

    if $force; then
        git worktree remove --force "$wt_path"
    else
        git worktree remove "$wt_path"
    fi
}
